<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="309.0" prefWidth="435.0" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dev.rampmaster.pooejemplo1.controller.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
      <HBox prefHeight="100.0" prefWidth="200.0">
         <children>
            <Label prefHeight="17.0" prefWidth="235.0" text="Mi Calculadora Magica" />
            <Button fx:id="aboutButton" mnemonicParsing="false" onAction="#onAbout" text="Acerca de" />
         </children>
      </HBox>
        <HBox alignment="CENTER" spacing="10.0">
            <children>
                <VBox maxWidth="Infinity" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Primer Numero" />
                        <TextField fx:id="numOne" />
                    </children>
                </VBox>
                <VBox maxWidth="Infinity" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Segundo Numero" />
                        <TextField fx:id="numTwo" />
                    </children>
                </VBox>
            </children>
        </HBox>

        <HBox alignment="CENTER" spacing="10.0">
            <children>
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onSumar" text="Sumar" HBox.hgrow="ALWAYS" />
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onRestar" text="Restar" HBox.hgrow="ALWAYS" />
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onMultiplicar" text="Multiplicar" HBox.hgrow="ALWAYS" />
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onDivision" text="Dividir" HBox.hgrow="ALWAYS" />
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onModulo" text="Modulo" HBox.hgrow="ALWAYS" />
            </children>
        </HBox>
        <HBox alignment="CENTER" spacing="10.0">
            <children>
                <Label maxWidth="Infinity" text="Resultado" HBox.hgrow="ALWAYS" />
                <Label fx:id="resultLabel" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
            </children>
        </HBox>
    </children>
</VBox>
