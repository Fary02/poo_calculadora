<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="309.0" prefWidth="302.0" spacing="20.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="dev.rampmaster.pooejemplo1.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <children>
      <Label text="Primer Numero" />
      <TextField fx:id="numOne" />
      <Label text="Segundo Numero" />
      <TextField fx:id="numTwo" />
      <Button mnemonicParsing="false" onAction="#onSumar" text="Sumar" />
      <Button mnemonicParsing="false" onAction="#onRestar" text="Restar" />
      <Label text="Resultado" />
      <Label fx:id="resultLabel" />
   </children>
</VBox>
